{
  "type": "runbook",
  "name": "Get Random Product",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "kind": "start",
        "x": -72,
        "y": 36
      },
      {
        "id": "produkte",
        "request": "requests/laendlekasse/produkte.json",
        "vars": {
          "base_url": "$env.body.base_url",
          "token": "$env.body.token"
        },
        "group": "GetProducts",
        "x": 420,
        "y": -48
      },
      {
        "id": "produkt",
        "request": "requests/laendlekasse/produkt.json",
        "vars": {
          "base_url": "$env.body.base_url",
          "token": "$env.body.token",
          "uuid": "$extract-3.body"
        },
        "x": 864,
        "y": 60
      },
      {
        "id": "extract-2",
        "kind": "extract",
        "vars": {
          "input": "$produkt.body"
        },
        "data": {
          "path": "data.featured.title"
        },
        "group": "gruppe",
        "x": 1332,
        "y": 312
      },
      {
        "id": "template",
        "kind": "template",
        "vars": {
          "input": "$extract-2.body"
        },
        "data": {
          "text": "{{input}} wurde abgefragt."
        },
        "group": "gruppe",
        "x": 1332,
        "y": 228
      },
      {
        "id": "extract",
        "kind": "extract",
        "vars": {
          "input": "$produkte.body"
        },
        "data": {
          "path": "data"
        },
        "group": "GetProducts",
        "x": 420,
        "y": 204
      },
      {
        "id": "sample",
        "kind": "sample",
        "vars": {
          "list": "$extract.body"
        },
        "group": "GetProducts",
        "x": 420,
        "y": 312
      },
      {
        "id": "extract-3",
        "kind": "extract",
        "vars": {
          "input": "$sample.body.value"
        },
        "data": {
          "path": "id"
        },
        "group": "GetProducts",
        "x": 420,
        "y": 420
      },
      {
        "id": "env",
        "kind": "env",
        "x": -72,
        "y": 132
      },
      {
        "id": "log",
        "kind": "log",
        "vars": {
          "input": "$template.body"
        },
        "data": {
          "label": ""
        },
        "group": "gruppe",
        "x": 1332,
        "y": 144
      },
      {
        "id": "export",
        "kind": "export",
        "vars": {
          "input": "$produkt.body"
        },
        "data": {
          "path": "exports/run.txt",
          "format": "text"
        },
        "group": "gruppe",
        "x": 1332,
        "y": -36
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "produkte"
      },
      {
        "from": "produkte.success",
        "to": "produkt"
      },
      {
        "from": "produkt",
        "to": "export"
      }
    ]
  },
  "description": "Dies ist ein test run book."
}
