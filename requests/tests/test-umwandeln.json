        "comment": "Erst danach heisst „> 5“, was es sagt.",
        "vars": {
          "input": "$antwort.body.anzahl"
        },
        "x": 420,
        "y": 432
      },
      {
        "id": "farbe",
        "kind": "tonumber",
        "name": "Hex zu Zahl",
        "vars": {
          "input": "$antwort.body.farbe"
        },
        "data": {
          "mode": "ganz",
          "base": "16"
        },
        "x": 420,
        "y": 552
      },
      {
        "id": "als_text",
        "kind": "totext",
        "name": "Als Text",
        "comment": "Eingerückt — und ohne Anführungszeichen darum, die beim Anhängen an eine Datei niemand haben will.",
        "vars": {
          "input": "$antwort.body"
        },
        "data": {
          "form": "eingerückt"
        },
        "x": 768,
        "y": 264
      },
      {
        "id": "waren",
        "kind": "json",
        "name": "Drei Waren",
        "data": {
          "value": "[{\"id\": 11, \"preis\": 250}, {\"id\": 12, \"preis\": 40}, {\"id\": 13, \"preis\": 99}]"
        },
        "x": 60,
        "y": 684
      },
      {
        "id": "grenze",
        "kind": "number",
        "name": "Grenze",
        "comment": "Einmal hier statt dreimal in der Zeile — als eigener Eingang am Map.",
        "data": {
          "value": "100"
        },
        "x": 60,
        "y": 828
      },
      {
        "id": "kennungen",
        "kind": "map",
        "name": "Nur die Kennungen",
        "comment": "Aus einer Liste die Kennungen zu ziehen ist kein Ablauf — deshalb eine Zeile und keine Schleife.",
        "vars": {
          "list": "$waren.body"
        },
        "data": {
          "expr": "item.id"
        },
        "x": 420,
        "y": 684
      },
      {
        "id": "teuer",
        "kind": "map",
        "name": "Über der Grenze?",
        "vars": {
          "list": "$waren.body",
          "grenze": "$grenze.body"
        },
        "data": {
          "expr": "item.preis > grenze"
        },
        "x": 420,
        "y": 828
      },
      {
        "id": "liste",
        "kind": "join",
        "name": "Als eine Zeile",
