      {
        "id": "start",
        "kind": "start",
        "x": 60,
        "y": 48
      },
      {
        "id": "antwort",
        "kind": "json",
        "name": "Eine Antwort",
        "comment": "Alles Text, wie es aus manchen Diensten wirklich kommt.",
        "data": {
          "value": "{\"aktiv\": \"false\", \"anzahl\": \"7\", \"farbe\": \"ff\"}"
        },
        "x": 60,
        "y": 264
      },
      {
        "id": "aktiv",
        "kind": "tobool",
        "name": "Wirklich aktiv?",
        "comment": "Ohne diesen Knoten wäre „false“ wahr — der Text ist ja nicht leer.",
        "vars": {
          "input": "$antwort.body.aktiv"
        },
        "x": 420,
        "y": 192
      },
      {
        "id": "streng",
        "kind": "tobool",
        "name": "Streng gelesen",
        "comment": "Nur „true“ und „false“ gelten. Bei einem Tippfehler steht hier ein Fehler statt eines stillen „wahr“.",
        "vars": {
          "input": "$antwort.body.aktiv"
        },
        "data": {
          "mode": "streng"
        },
        "x": 420,
        "y": 312
      },
      {
        "id": "anzahl",
        "kind": "tonumber",
