{
  "type": "runbook",
  "name": "Get API Infos",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "kind": "start",
        "x": 80,
        "y": 60
      },
      {
        "id": "status",
        "request": "requests/lhgv/requests/status.json",
        "x": 408,
        "y": 60
      },
      {
        "id": "keys",
        "kind": "keys",
        "vars": {
          "input": "$status.body"
        },
        "data": {
          "in": "routes"
        },
        "x": 408,
        "y": 360
      },
      {
        "id": "export",
        "kind": "export",
        "vars": {
          "input": "$join.body"
        },
        "data": {
          "path": "requests/lhgv/exports/available-routes.txt",
          "format": "text",
          "mode": "ersetzen"
        },
        "x": 780,
        "y": 60
      },
      {
        "id": "join",
        "kind": "join",
        "vars": {
          "list": "$map.body.items"
        },
        "data": {
          "list": "",
          "separator": "\\n"
        },
        "x": 780,
        "y": 240
      },
      {
        "id": "end",
        "kind": "end",
        "vars": {
          "routes": "$join.body"
        },
        "data": {
          "label": ""
        },
        "ports": [
          "routes"
        ],
        "x": 1152,
        "y": 60
      },
      {
        "id": "zip",
        "kind": "zip",
        "vars": {
          "a": "$keys.body.keys",
          "b": "$keys.body.values"
        },
        "data": {
          "names": ""
        },
        "x": 408,
        "y": 492
      },
      {
        "id": "map",
        "kind": "map",
        "vars": {
          "list": "$zip.body.items"
        },
        "data": {
          "expr": "item.a + ': ' + item.b.route"
        },
        "x": 408,
        "y": 624
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "status"
      },
      {
        "from": "status.success",
        "to": "export"
      },
      {
        "from": "export.success",
        "to": "end"
      }
    ]
  }
}
