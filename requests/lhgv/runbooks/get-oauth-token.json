{
  "type": "runbook",
  "name": "Get Oauth Token",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "kind": "start",
        "x": 80,
        "y": 60
      },
      {
        "id": "oauth",
        "kind": "oauth",
        "vars": {
          "client_id": "$env.body.client_id",
          "client_secret": "$env.body.client_secret",
          "username": "$env.body.username",
          "password": "$env.body.password",
          "url": "$template.body"
        },
        "data": {
          "url": "",
          "grant": "password",
          "client_id": "",
          "client_secret": "",
          "username": "",
          "password": "",
          "refresh_token": "",
          "scope": "",
          "send": "basic",
          "extra": ""
        },
        "x": 528,
        "y": 108
      },
      {
        "id": "env",
        "kind": "env",
        "x": 84,
        "y": 192
      },
      {
        "id": "state",
        "kind": "state",
        "vars": {
          "input": "$makeobject.body"
        },
        "data": {
          "name": "token",
          "scope": "folder"
        },
        "x": 528,
        "y": 408
      },
      {
        "id": "state-2",
        "kind": "state",
        "data": {
          "name": "token",
          "scope": "folder"
        },
        "x": 528,
        "y": -228
      },
      {
        "id": "condition",
        "kind": "condition",
        "vars": {
          "input": "$state-2.body.value",
          "expired": "$relativetime.body.past"
        },
        "data": {
          "expr": "input !== null && !expired"
        },
        "ports": [
          "expired"
        ],
        "portTypes": {
          "expired": "boolean"
        },
        "x": 528,
        "y": -48
      },
      {
        "id": "time",
        "kind": "time",
        "vars": {
          "date": "$state-2.body.value.expires_at"
        },
        "data": {
          "date": "",
          "offset": ""
        },
        "x": 84,
        "y": -228
      },
      {
        "id": "makeobject",
        "kind": "makeobject",
        "vars": {
          "token": "$oauth.body.access_token",
          "expires_at": "$oauth.body.expires_at"
        },
        "data": {
          "fields": ""
        },
        "ports": [
          "token",
          "expires_at"
        ],
        "portTypes": {
          "token": "string",
          "expires_at": "date"
        },
        "x": 528,
        "y": 588
      },
      {
        "id": "state-3",
        "kind": "state",
        "data": {
          "name": "token",
          "scope": "folder"
        },
        "x": 900,
        "y": -24
      },
      {
        "id": "extract-2",
        "kind": "extract",
        "vars": {
          "input": "$state-3.body.value"
        },
        "data": {
          "path": "token"
        },
        "x": 900,
        "y": 156
      },
      {
        "id": "relativetime",
        "kind": "relativetime",
        "vars": {
          "date": "$time.body.iso"
        },
        "data": {
          "date": ""
        },
        "x": 84,
        "y": -96
      },
      {
        "id": "end",
        "kind": "end",
        "vars": {
          "token": "$extract-2.body"
        },
        "data": {
          "label": ""
        },
        "ports": [
          "token"
        ],
        "x": 1296,
        "y": 0
      },
      {
        "id": "template",
        "kind": "template",
        "vars": {
          "input": "$env.body.base_url"
        },
        "data": {
          "text": "{{input}}/api/oauth/v1/token"
        },
        "x": 84,
        "y": 396
      }
    ],
    "edges": [
      {
        "from": "oauth.success",
        "to": "state"
      },
      {
        "from": "state-2.success",
        "to": "condition"
      },
      {
        "from": "condition.else",
        "to": "oauth"
      },
      {
        "from": "condition.then",
        "to": "state-3"
      },
      {
        "from": "state.success",
        "to": "state-3"
      },
      {
        "from": "state-3.success",
        "to": "end"
      },
      {
        "from": "start",
        "to": "state-2"
      }
    ]
  }
}
