{
  "name": "List Categories",
  "method": "GET",
  "url": "{{base_url}}/api/rest/v1/categories",
  "query": [
    {
      "key": "limit",
      "value": "50"
    },
    {
      "key": "search",
      "value": "{\"code\":[{\"operator\":\"IN\",\"value\":[\"Gastronomie\"]}]}",
      "enabled": false
    }
  ],
  "auth": {
    "type": "bearer",
    "token": "{{token}}"
  }
}
